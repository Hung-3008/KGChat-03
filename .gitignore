# Standard .gitignore for Python projects

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.pyd
*.dll

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt
.installed.cfg

# Virtual environments
venv/
ENV/
env/
.venv/
venv.bak/

# PyInstaller
*.spec

# Unit test / coverage
.coverage
.coverage.*
.cache
.pytest_cache/
htmlcov/

# Type checkers / caches
.mypy_cache/
.pyre/
.pytype/

# Django / Flask / general local files
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache

# Sphinx documentation
docs/_build/

# Jupyter
.ipynb_checkpoints

# Editor/IDE settings
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
.ropeproject/

# OS files
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
.envrc

# Misc
celerybeat-schedule
.python-version
data/*
output/*
scripts/*
!scripts/test_gemini_client.py
!scripts/sample_input.jsonl
!scripts/test_entity_linking.py
!scripts/test_biosyn_duckdb.py
!scripts/test_edge_extractor_biosyn.py
!scripts/debug_graph_extraction.py
!scripts/debug_schema.py
!scripts/test_level2_nodes.py
!scripts/debug_node_extractor.py
!scripts/test_schema_fix.py
*.ipynb
commands.ipynb
.github/*
qdrant_storage/*
backend/krissbert_custom/umls_full.json
backend/krissbert_custom/pytorch_model.bin
outputs/*
backend/krissbert_custom/prototypes/*
backend/krissbert_custom/prototypes.tar.gz
qdrant
qdrant-x86_64-unknown-linux-gnu.tar.gz
package-lock.json
wget-log
storage/
.qdrant-initialized